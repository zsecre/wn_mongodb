<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#3300FFFF"
        android:alpha="0.3"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp">

            <!-- Step 1: Input -->
            <LinearLayout
                android:id="@+id/onboarding_input_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/onboarding_welcome_icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="64dp"
                    android:layout_marginBottom="32dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Welcome Icon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to "
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WatchNinja"
                    android:textColor="@color/brand_cyan"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your ultimate destination for endless entertainment. Let\'s get to know you better."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="32dp"/>

                <EditText
                    android:id="@+id/onboarding_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your name"
                    android:textColorHint="#52525B"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:inputType="textPersonName"
                    android:maxLength="10"
                    android:padding="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/onboarding_char_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/10 chars"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/onboarding_next_btn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Next"
                    android:textColor="@color/bg_deep"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/bg_play_btn"
                    android:foreground="@null"
                    android:stateListAnimator="@null"
                    android:alpha="0.4"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watch Movies - TV Shows - Anime - Free Forever"
                    android:textColor="#52525B"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="32dp"/>
            </LinearLayout>

            <!-- Step 2: Success -->
            <LinearLayout
                android:id="@+id/onboarding_success_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar_cyan"
                    android:layout_marginTop="64dp"
                    android:layout_marginBottom="32dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thanks,"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"/>

                <TextView
                    android:id="@+id/onboarding_success_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_cyan"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You\'re all set! Watch your favorite movies, TV shows, and anime for free."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:layout_marginBottom="32dp"/>

                <Button
                    android:id="@+id/onboarding_start_btn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Start Watching"
                    android:textColor="@color/bg_deep"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/bg_play_btn"
                    android:foreground="@null"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watch Movies - TV Shows - Anime - Free Forever"
                    android:textColor="#52525B"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="32dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
