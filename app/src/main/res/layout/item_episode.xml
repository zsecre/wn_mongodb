<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="192dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="12dp"
    android:background="@null"
    android:foreground="@null">
    
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ep_card"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:strokeColor="@color/me_card_border"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <ImageView
                android:id="@+id/ep_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
                
            <LinearLayout
                android:id="@+id/ep_playing_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#88000000"
                android:visibility="gone">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/brand_cyan"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playing"
                    android:textColor="@color/brand_cyan"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/ep_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_ep_num_badge"
                android:textColor="@color/bg_deep"
                android:textSize="8sp"
                android:fontFamily="sans-serif-bold"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    
    <TextView
        android:id="@+id/ep_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"/>
        
    <TextView
        android:id="@+id/ep_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="9sp"/>
</LinearLayout>
