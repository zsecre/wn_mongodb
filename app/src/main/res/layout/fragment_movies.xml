<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="64dp">

            <!-- Slideshow -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/slideshow_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <me.relex.circleindicator.CircleIndicator3
                    android:id="@+id/slideshow_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    app:ci_width="6dp"
                    app:ci_height="6dp"
                    app:ci_margin="4dp"/>

            </FrameLayout>

            <!-- Genre chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingLeft="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false">
                <LinearLayout
                    android:id="@+id/genre_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingRight="20dp"/>
            </HorizontalScrollView>

            
            <include android:id="@+id/row_trending_movies" layout="@layout/layout_media_row"/>
            <include android:id="@+id/row_anime_movies"    layout="@layout/layout_media_row"/>
            <include android:id="@+id/row_popular_movies"  layout="@layout/layout_media_row"/>
            <include android:id="@+id/row_top_movies"      layout="@layout/layout_media_row"/>
            <include android:id="@+id/row_top_anime"       layout="@layout/layout_media_row"/>

            <include layout="@layout/layout_search_footer"/>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/layout_header"/>

</FrameLayout>
