<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/header_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:text="WatchNinja"
        android:textColor="@color/brand_cyan"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.03"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="12dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/header_notification_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_ctrl"
                android:foreground="@null"
                android:src="@drawable/ic_notifications"
                android:scaleType="centerInside"
                android:contentDescription="Notifications"
                android:padding="10dp"/>

            <View
                android:id="@+id/header_notification_badge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_notification_badge"
                android:visibility="gone"/>
        </FrameLayout>

        <ImageButton
            android:id="@+id/header_search_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_ctrl"
            android:foreground="@null"
            android:src="@drawable/ic_search"
            android:scaleType="centerInside"
            android:contentDescription="Search"
            android:padding="10dp"/>
    </LinearLayout>

</FrameLayout>
