# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY
# Central database URL: either your MongoDB REST API server (e.g. https://your-watchninja-api.onrender.com) or Firebase RTDB
DB_URL=https://watchable-5a2ab-default-rtdb.asia-southeast1.firebasedatabase.app/
# MongoDB Atlas Connection String (for backend server)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/watchninja?retryWrites=true&w=majority
